            "type": "string",
            "minLength": 8
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest"
      },
      "StoreRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 3,
            "maxLength": 255
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "user_id": {
            "type": "integer"
          }
        },
        "required": [
          "name",
          "user_id"
        ],
        "title": "StoreRequest"
      },
      "UpdateRequest": {
        "type": "object",
        "properties": {
          "project_id": {
            "type": "integer"
