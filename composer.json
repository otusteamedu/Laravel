{
    "name": "vagrant/ascii",
    "description": "Image to Ascii generator",
    "type": "library",
    "autoload": {
        "psr-4": {
            "Vagrant\\Ascii\\": "src/"
        }
    },
    "require": {
        "illuminate/support": "^12.0",
        "illuminate/http": "^12.0",
        "ilya-nurullin/img2ascii": "dev-master"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Vagrant\\Ascii\\ServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "git",
            "url": "https://github.com/ilya-nurullin/img2ascii.git"
        }
    ]
}
