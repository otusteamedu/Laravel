### Get all products (paginated)
GET {{host}}/api/v1/products
Authorization: Bearer {{token}}
Accept: application/json
Content-Type: application/json

### Get products with filters
GET {{host}}/api/v1/products?category_id=1&is_sale=1&sort=price&direction=desc&per_page=5
Authorization: Bearer {{token}}
Accept: application/json
Content-Type: application/json

### Get single product by ID
GET {{host}}/api/v1/products/1
Authorization: Bearer {{token}}
Accept: application/json
Content-Type: application/json

### Create new product
POST {{host}}/api/v1/products
Authorization: Bearer {{token}}
Accept: application/json
Content-Type: application/json

{
    "title": "New Product",
    "price": 99.99,
    "published": true,
    "categories": [1, 2],
    "image": "product.jpg",
    "is_sale": true
}

### Update product
PUT {{host}}/api/v1/products/1
Authorization: Bearer {{token}}
Accept: application/json
Content-Type: application/json

{
    "title": "Updated Product Name",
    "price": 109.99,
    "categories": [1, 3]
}

### Delete product
DELETE {{host}}/api/v1/products/72
Authorization: Bearer {{token}}
Accept: application/json
Content-Type: application/json

### Get all categories (paginated)
GET {{host}}/api/v1/categories
Authorization: Bearer {{token}}
Accept: application/json
Content-Type: application/json

### Get categories with products included
GET {{host}}/api/v1/categories?with_products=1
Authorization: Bearer {{token}}
Accept: application/json
Content-Type: application/json

### Get single category by ID
GET {{host}}/api/v1/categories/1
Authorization: Bearer {{token}}
Accept: application/json
Content-Type: application/json

### Get category with products
GET {{host}}/api/v1/categories/1?with_products=1
Authorization: Bearer {{token}}
Accept: application/json
Content-Type: application/json

### Create new category
POST {{host}}/api/v1/categories
Authorization: Bearer {{token}}
Accept: application/json
Content-Type: application/json

{
    "title": "New Category",
    "published": true,
    "order": 5
}

### Update category
PUT {{host}}/api/v1/categories/1
Authorization: Bearer {{token}}
Accept: application/json
Content-Type: application/json

{
    "title": "Updated Category Name",
    "published": false
}

### Delete category
DELETE {{host}}/api/v1/categories/6
Authorization: Bearer {{token}}
Accept: application/json
Content-Type: application/json

