FROM cr.yandex/crp5vqb7o300rt2pnmkk/dev-php8.3:latest

ARG DOCKER_UID
ARG DOCKER_GID
ARG DOCKER_SYNC_UID_GID
ARG DOCKER_SYNC_VERBOSE
ARG DOCKER_SYNC_WORKDIR_PERMS

ENV DOCKER_GID=${DOCKER_GID}
ENV DOCKER_UID=${DOCKER_UID}
ENV DOCKER_SYNC_UID_GID=${DOCKER_SYNC_UID_GID}
ENV DOCKER_SYNC_VERBOSE=${DOCKER_SYNC_VERBOSE}
ENV DOCKER_SYNC_WORKDIR_PERMS=${DOCKER_SYNC_WORKDIR_PERMS}

ENV S6_CMD_WAIT_FOR_SERVICES=0
ENV S6_CMD_WAIT_FOR_SERVICES_MAXTIME=3600000

COPY ./.docker/etc/nginx/. /etc/nginx/
COPY ./.docker/etc/php/current/. /etc/php/current/
COPY ./.docker/etc/s6-overlay/. /etc/s6-overlay/

CMD sleep 3650d
